################################
# Moov Money (Gabon) - Paiement en ligne marchand (SOAP InitTrans_OnlineMerchantPayment)
################################

################################
# URL de l'API Moov où envoyer la requête SOAP (fournie par Moov)
################################
MOOV_PAYMENT_BASE_URL=

################################
# req:Caller/ThirdPartyID - Identifiant du système tiers (partenaire) dans la plateforme Moov
################################
MOOV_THIRD_PARTY_ID=RENGUS

################################
# req:Caller/Password - Mot de passe du Caller (souvent chiffré 3DES/RSA)
################################
MOOV_PAYMENT_PASSWORD=

################################
# req:Caller/ResultURL - URL de callback où Moov envoie le Result (succès/échec). Doit être accessible par les serveurs Moov
################################
MOOV_RESULT_URL=

################################
# req:Initiator/Identifier - Identifiant de l'initiateur (opérateur/organisation)
################################
MOOV_INITIATOR_IDENTIFIER=RENGUS

################################
# req:Initiator/SecurityCredential - PIN ou secret de l'initiateur (souvent chiffré)
################################
MOOV_SECURITY_CREDENTIAL=

################################
# req:Header/ChannelCode - Code du canal (ex. 1010 = API)
################################
MOOV_CHANNEL_CODE=1010

################################
# req:ReceiverParty/Identifier - Short code du marchand qui reçoit le paiement
################################
MOOV_MERCHANT_SHORTCODE=

################################
# req:Requester/Identifier - Identifiant du requester (ex. compte marchand)
################################
MOOV_REQUESTER_IDENTIFIER=I0200

################################
# req:Header/KeyOwner - Propriétaire de la clé (contexte chiffrement)
################################
MOOV_KEY_OWNER=1

################################
# req:Caller/CallerType - Type d'appelant (2 = système tiers / API Caller)
################################
MOOV_CALLER_TYPE=2

################################
# Moov / Rengus — vérification paiement (REST, distinct du SOAP Moov ci-dessus)
# Utilisé par POST /api/paiements/moov/verifier-commande (JWT /get-token + /check-order).
# Détail : README_MOOV_RENGUS_VERIFICATION.md
################################
# URL de base sans slash final en trop (ex. https://hôte:port)
MOOV_RENGUS_API_BASE_URL=https://172.16.14.6:5000
# Identifiants fournis par Rengus pour obtenir le JWT serveur (pas le token utilisateur permis-conduire)
MOOV_RENGUS_USERNAME=
MOOV_RENGUS_PASSWORD=
# Vérification du certificat TLS des appels vers Rengus : true si certificat public valide ; false si interne / auto-signé
MOOV_RENGUS_VERIFY_SSL=false
# Délai max en secondes pour get-token et check-order
MOOV_RENGUS_TIMEOUT=25

################################
# Scramble — documentation OpenAPI (/docs/api, export spec)
################################
# URL affichée pour Try It (optionnel ; défaut : APP_URL + /api)
# SCRAMBLE_SERVER_URL=
# HTTP Basic avant d’ouvrir la doc  : renseigner les DEUX pour activer ; vides = pas de garde (ex. local)
SCRAMBLE_DOCS_USER=
SCRAMBLE_DOCS_PASSWORD=

