################################
# API publique (header X-API-KEY)
# Routes : GET /api/public/paiements/exists, GET /api/v1/permis/usager, etc.
################################
PUBLIC_API_KEY=

# Liste d’IP autorisées (virgules). Vide = pas de filtre. Sinon : 1re IP du header X-Forwarded-For comparée à la liste.
PUBLIC_API_ALLOWED_IPS=

# Clés révoquées (virgules) → réponse HTTP 403 « Clé API révoquée » si un client les envoie encore.
PUBLIC_API_REVOKED_KEYS=
