# Utilise une image de base PHP avec FPM pour le serveur web.
FROM php:8.2-fpm-alpine

# Installe les dépendances système nécessaires sur Alpine.
# Ajout de 'postgresql-dev' pour l'installation des extensions PHP PostgreSQL.
# J'ai éliminé tout espace potentiel après les backslashes (\) pour éviter l'erreur "unknown instruction".
RUN apk update && apk upgrade && apk add --no-cache \
    nginx \
    git \
    curl \
    libpng-dev \
    libjpeg-turbo-dev \
    libwebp-dev \
    freetype-dev \
    libzip-dev \
    zlib-dev \
    libxml2-dev \
    supervisor \
    postgresql-dev \
    gmp-dev \
    && rm -rf /var/cache/apk/*

# Copie le binaire Composer depuis une image séparée.
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Crée et configure les extensions PHP.
# Installation des extensions 'pdo_pgsql' et 'pgsql' en plus des autres.
RUN docker-php-ext-configure gd --with-jpeg --with-webp --with-freetype && \
    docker-php-ext-install -j$(nproc) gd pdo_mysql zip exif pcntl opcache pdo_pgsql pgsql gmp bcmath

# Crée un utilisateur pour les droits de sécurité.
ARG uid=1000
RUN adduser -u $uid -D -s /bin/sh laravel

# Définit le répertoire de travail dans le conteneur.
WORKDIR /var/www

# Copie le code source de l'application.
COPY . /var/www

# Exécute l'installation des dépendances Composer.
RUN composer install --no-dev --optimize-autoloader

# Crée et donne les permissions nécessaires pour Laravel.
#RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache
#RUN  chmod -R ug+rwX /var/www/storage /var/www/bootstrap/cache

# **CORRECTION CRUCIALE POUR NGINX**
# Crée une configuration Nginx propre qui inclut les fichiers de conf.d
# Cela résout l'erreur `server directive not allowed`.
RUN printf "events {}\nhttp {\n    include /etc/nginx/conf.d/*;\n}" > /etc/nginx/nginx.conf

# Copie la configuration de Nginx (votre fichier server) et de Supervisor.
COPY ./nginx.conf /etc/nginx/conf.d/default.conf
COPY ./supervisord.conf /etc/supervisord.conf

# Permissions (écriture Laravel)
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache \
 && chmod -R ug+rwX /var/www/storage /var/www/bootstrap/cache


# Lance le processus Supervisor pour démarrer Nginx et PHP-FPM.
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
